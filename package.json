{
	"name": "booklet",
	"version": "1.1.1",
	"description": "An Obsidian plugin: a Booklet note opens in a view of its own, and the answers given there are written into its records section.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node test/build-for-tests.mjs && node --test test/*.test.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"e2e:android:setup": "npm --prefix e2e-tests/android ci",
		"e2e:android": "node e2e-tests/android/run.mjs"
	},
	"license": "Apache-2.0",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@eslint/json": "0.14.0",
		"esbuild": "0.25.5",
		"eslint": "9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"jsdom": "26.1.0",
		"obsidian": "1.14.4",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1"
	},
	"dependencies": {
		"monkey-around": "3.0.0"
	}
}
